# go-sana-backend environment configuration
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# Generate a strong secret with:
#   openssl rand -base64 48

# HTTP port the Fiber server listens on.
PORT=9000

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# MongoDB database name.
MONGO_DB=sana

# Default administrator seeded on first startup (see connections.DefaultUser).
DEF_USER=admin@example.com

# Password for the default administrator. Only applied if the user does not exist yet.
DEF_PASS=change-me

# Secret used to sign access tokens. REQUIRED - do not use the fallback.
JWT_SECRET=

# Secret used to sign refresh tokens. MUST be different from JWT_SECRET.
JWT_REFRESH_SECRET=